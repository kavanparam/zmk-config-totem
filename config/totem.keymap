//
//                                                        ▀▀▀▀▀     ▀▀▀▀▀          ▀▀█▀▀
//                                                        ▄▀▀▀▄  ▄  ▄▀▀▀▄  ▄  ▄▀▀▀▄  █  ▄▀▀▀▄
//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        undo {
            bindings = <&kp LG(Z)>;
            key-positions = <12 23>;
            layers = <0>;
            timeout-ms = <25>;
            require-prior-idle-ms = <100>;
        };

        redo {
            bindings = <&kp LG(LS(Z))>;
            key-positions = <11 22>;
            layers = <0>;
            timeout-ms = <25>;
            require-prior-idle-ms = <100>;
        };

        paste {
            bindings = <&kp LG(V)>;
            key-positions = <23 24>;
            layers = <0>;
            timeout-ms = <22>;
            require-prior-idle-ms = <150>;
        };

        copy {
            bindings = <&kp LG(C)>;
            key-positions = <23 22>;
            layers = <0>;
            timeout-ms = <22>;
            require-prior-idle-ms = <150>;
        };

        shift {
            bindings = <&st_shift LSHIFT>;
            key-positions = <24 25>;
            layers = <0 1 8 9>;
            timeout-ms = <18>;
            require-prior-idle-ms = <150>;
        };

        cut {
            bindings = <&kp LG(X)>;
            key-positions = <22 24>;
            layers = <0>;
            timeout-ms = <22>;
            require-prior-idle-ms = <150>;
        };

        f_emdash {
            bindings = <&kp LA(LS(MINUS))>;
            key-positions = <13 22>;
            layers = <0>;
            timeout-ms = <25>;
            require-prior-idle-ms = <150>;
        };

        escape {
            bindings = <&kp ESC>;
            key-positions = <1 2>;
            layers = <0>;
            timeout-ms = <22>;
            require-prior-idle-ms = <150>;
        };

        enter {
            bindings = <&kp ENTER>;
            key-positions = <7 6>;
            timeout-ms = <25>;
            require-prior-idle-ms = <100>;
        };

        select-all {
            bindings = <&kp LG(A)>;
            key-positions = <10 0>;
            timeout-ms = <25>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        zoom-in {
            bindings = <&kp LG(EQUAL)>;
            key-positions = <9 19>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        zoom-out {
            bindings = <&kp LG(MINUS)>;
            key-positions = <30 19>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        l-raycast {
            bindings = <&kp LG(LS(LA(LC(SPACE))))>;
            key-positions = <3 13>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <2 3>;
            timeout-ms = <22>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        r-mouse {
            bindings = <&tog 10>;
            key-positions = <7 8>;
            timeout-ms = <12>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        l-play_pause {
            bindings = <&kp C_PLAY_PAUSE>;
            key-positions = <13 33>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        f_bold {
            bindings = <&kp LG(B)>;
            key-positions = <13 25>;
            timeout-ms = <18>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        f_italic {
            bindings = <&kp LG(I)>;
            key-positions = <13 7>;
            timeout-ms = <25>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        f_dash {
            bindings = <&kp MINUS>;
            key-positions = <13 27>;
            timeout-ms = <25>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        f_highlight {
            bindings = <&kp LG(LS(H))>;
            key-positions = <13 15>;
            timeout-ms = <25>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        f_dash2 {
            bindings = <&kp MINUS>;
            key-positions = <13 23>;
            timeout-ms = <25>;
            require-prior-idle-ms = <150>;
            layers = <0>;
        };

        r-raycast {
            bindings = <&kp LG(LS(LA(LC(SPACE))))>;
            key-positions = <6 16>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        r-play_pause {
            bindings = <&kp C_PLAY_PAUSE>;
            key-positions = <16 36>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        l-undo2 {
            bindings = <&kp LG(Z)>;
            key-positions = <12 33>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        l-redo2 {
            bindings = <&kp LG(LS(Z))>;
            key-positions = <12 34>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        l-raycast2 {
            bindings = <&kp LG(LS(LA(LC(SPACE))))>;
            key-positions = <13 34>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        r-back {
            bindings = <&kp LG(LBKT)>;
            key-positions = <15 37>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        r-prev_tab {
            bindings = <&kp LC(LS(TAB))>;
            key-positions = <37 16>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        r-next_tab {
            bindings = <&kp LC(TAB)>;
            key-positions = <37 17>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        r-forward {
            bindings = <&kp LG(RBKT)>;
            key-positions = <37 18>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };

        r-close {
            bindings = <&kp LG(W)>;
            key-positions = <37 19>;
            timeout-ms = <30>;
            require-prior-idle-ms = <50>;
            layers = <0>;
        };
    };

    behaviors {
        lt_ext: lt_ext {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_EXT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <300>;
            quick-tap-ms = <200>;
        };

        ht_thrm: ht_hrm {
            compatible = "zmk,behavior-hold-tap";
            label = "Urod timeless hrm, zmk config.";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <350>;
            quick-tap-ms = <200>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            hold-trigger-on-release;
        };

        mm_optdel: mm_optdel {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_OPTDEL";
            bindings = <&kp LA(BACKSPACE)>, <&kp LA(DEL)>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        ht_optdel: ht_optdel {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_OPTDEL";
            bindings = <&mo>, <&mm_optdel>;

            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
        };

        td_esclock: td_esclock {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_ESCLOCK";
            #binding-cells = <0>;
            bindings = <&ht_td_esclock 11 ESC>, <&kp LG(LC(Q))>;
        };

        ht_shift: ht_shift {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_SHIFT";
            bindings = <&kp>, <&mm_shift_capsword>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        st_shift: st_shift {
            compatible = "zmk,behavior-sticky-key";
            label = "ST_SHIFT";
            bindings = <&kp>;
            #binding-cells = <1>;
            quick-release;
            release-after-ms = <2000>;
            ignore-modifiers;
        };

        ht_td_esclock: ht_td_esclock {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_TD_ESCLOCK";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            bindings = <&mo>, <&kp>;
        };

        mm_shift_capsword: mm_shift_capsword {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_SHIFT_CAPSWORD";
            bindings = <&st_shift LSHIFT>, <&caps_word>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT)>;
        };

        ht_r_thrm: ht_r_thrm {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_R_THRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <350>;
            quick-tap-ms = <200>;
            flavor = "balanced";
            require-prior-idle-ms = <170>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <35 36 37 32 33 34 2 3 4 13 12 13 23 14 14 25 24 22 1 11 10 21 0 10 20 1 2 3 4 11 12 13 14 22 23 24 25 0>;
        };

        ht_l_thrm: ht_l_thrm {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_L_THRM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <350>;
            quick-tap-ms = <200>;
            flavor = "balanced";
            require-prior-idle-ms = <170>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <35 36 37 32 33 34 5 15 26 27 16 6 7 17 28 29 18 8 9 19 30 31>;
        };

        ht_bspc: ht_bspc {
            compatible = "zmk,behavior-hold-tap";
            label = "HT_BSPC";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&mm_del>;
        };

        mm_del: mm_del {
            compatible = "zmk,behavior-mod-morph";
            label = "MM_DEL";
            bindings = <&kp BSPC>, <&kp DEL>;

            #binding-cells = <0>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
             &kp Q              &kp W              &kp E                &kp R               &kp T           &kp Y                    &kp U               &kp I                &kp O              &kp P
             &ht_l_thrm LCMD A  &ht_l_thrm LALT S  &ht_l_thrm LSHIFT D  &ht_l_thrm LCTRL F  &lt_ext 12 G    &kp H                    &ht_r_thrm RCTRL J  &ht_r_thrm RSHIFT K  &ht_r_thrm RALT L  &ht_r_thrm LCMD SEMICOLON
&td_esclock  &kp Z              &kp X              &kp C                &kp V               &kp B           &kp N                    &kp M               &kp COMMA            &kp DOT            &kp FSLH                   &lt_ext 11 APOSTROPHE
                                                   &lt 3 ESCAPE         &lt 1 SPACE         &lt 8 TAB       &ht_shift LSHIFT LSHIFT  &lt 2 BSPC          &ht_optdel 3 0
            >;
        };

        nav_num {
            bindings = <
           &kp LA(BACKSPACE)  &kp BACKSPACE  &kp UP    &kp DELETE  &kp LA(DELETE)    &kp STAR          &kp N7         &kp N8  &kp N9  &kp DOT
           &msc SCRL_UP       &kp LEFT       &kp DOWN  &kp RIGHT   &mkp LCLK         &kp PLUS          &kp N4         &kp N5  &kp N6  &kp COLON
&kp GRAVE  &msc SCRL_DOWN     &kp ESC        &kp TAB   &kp ENTER   &kp LS(TAB)       &kp MINUS         &kp NUMBER_1   &kp N2  &kp N3  &kp SLASH  &kp PERCENT
                                             &to 0     &trans      &trans            &mt LSHIFT EQUAL  &kp BACKSPACE  &kp N0
            >;
        };

        sym_func {
            bindings = <
           &kp HASH  &kp LEFT_BRACE        &kp RIGHT_BRACE        &kp AMPS     &kp CARET        &kp F15  &kp F7  &kp F8  &kp F9  &kp F12
           &kp STAR  &kp LBKT              &kp RBKT               &kp PERCENT  &kp BACKSLASH    &kp F14  &kp F4  &kp F5  &kp F6  &kp F11
&kp GRAVE  &kp LT    &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDER    &kp GT           &kp F13  &kp F1  &kp F2  &kp F3  &kp F10  &trans
                                           &kp N0                 &kp SPACE    &kp DOLLAR       &trans   &trans  &trans
            >;
        };

        z_hyp {
            bindings = <
        &kp LS(LA(LC(LG(Q))))  &kp BACKSPACE            &kp LA(RIGHT)          &kp DEL                  &trans                   &kp LG(UP)             &kp LA(UP)                 &kp LG(LEFT)               &kp LG(RIGHT)  &kp LG(DOWN)
        &kp CAPS               &lt 6 LS(LA(LC(LG(S))))  &kp LA(DOWN)           &lt 5 LS(LA(LC(LG(F))))  &kp LS(LA(LC(LG(G))))    &kp LEFT               &kp DOWN                   &kp UP                     &kp RIGHT      &kp SPACE
&trans  &trans                 &trans                   &kp LS(LA(LC(LG(C))))  &trans                   &kp LA(LEFT)             &kp LS(LA(LC(LG(N))))  &mt LA(LS(LEFT)) LA(BSPC)  &mt LA(LS(RIGHT)) LA(DEL)  &kp ESC        &kp ENTER     &tog 3
                                                        &to 0                  &trans                   &trans                   &kp SPACE              &trans                     &trans
            >;
        };

        z_hyp_num {
            bindings = <
        &trans  &trans  &trans  &trans  &trans    &trans  &kp LS(LA(LC(LG(N7))))  &kp LS(LA(LC(LG(N8))))  &kp LS(LA(LC(LG(N9))))  &trans
        &trans  &trans  &trans  &trans  &trans    &trans  &kp LS(LA(LC(LG(N4))))  &kp LS(LA(LC(LG(N5))))  &kp LS(LA(LC(LG(N6))))  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &kp LS(LA(LC(LG(N1))))  &kp LS(LA(LC(LG(N2))))  &kp LS(LA(LC(LG(N3))))  &tog 4  &trans
                        &to 0   &trans  &trans    &trans  &trans                  &trans
            >;
        };

        format {
            bindings = <
        &trans  &trans         &kp LS(LA(RIGHT))  &trans            &trans              &kp LG(LS(UP))  &kp LS(LA(UP))  &kp LS(LG(LEFT))  &kp LS(LG(RIGHT))  &kp LS(LG(DOWN))
        &trans  &kp LS(LG(S))  &kp LS(LA(DOWN))   &trans            &trans              &kp LS(LEFT)    &kp LS(DOWN)    &kp LS(UP)        &kp LS(RIGHT)      &kp LG(K)
&trans  &trans  &kp LG(X)      &kp LG(C)          &kp LG(V)         &kp LS(LA(LEFT))    &kp LEFT        &kp DOWN        &kp UP            &kp RIGHT          &trans            &trans
                               &kp LG(V)          &kp LA(LS(LEFT))  &trans              &trans          &trans          &trans
            >;
        };

        system {
            bindings = <
        &trans  &trans  &trans  &trans                 &trans                   &trans                &trans           &trans       &trans                 &trans
        &trans  &trans  &trans  &kp LS(LA(LG(LC(F))))  &kp LS(LC(LA(LG(G))))    &kp LG(LEFT_BRACKET)  &kp LC(LS(TAB))  &kp LC(TAB)  &kp LG(RIGHT_BRACKET)  &kp LG(W)
&trans  &trans  &trans  &trans  &trans                 &trans                   &trans                &trans           &trans       &trans                 &trans     &trans
                        &trans  &trans                 &trans                   &trans                &trans           &trans
            >;
        };

        lightroom {
            bindings = <
       &kp LG(LS(C))  &kp LG(Z)  &kp LG(LS(Z))  &kp LG(LA(V))  &none        &none  &none  &none  &none  &none
       &none          &kp LEFT   &none          &kp RIGHT      &none        &none  &none  &none  &none  &none
&none  &none          &none      &none          &none          &none        &none  &none  &none  &none  &none  &none
                                 &to 0          &none          &mkp LCLK    &none  &none  &none
            >;
        };

        l_single {
            bindings = <
               &kp P          &kp O       &kp I      &kp U   &kp Y     &trans  &trans  &trans  &trans  &trans
               &kp SEMICOLON  &kp L       &kp K      &kp J   &kp H     &trans  &trans  &trans  &trans  &trans
&kp BACKSPACE  &kp SLASH      &kp PERIOD  &kp COMMA  &kp M   &kp N     &trans  &trans  &trans  &trans  &trans  &trans
                                          &to 0      &tog 9  &trans    &trans  &trans  &trans
            >;
        };

        l_num {
            bindings = <
        &trans  &kp N7  &kp N8  &kp N9  &trans    &trans  &trans  &trans  &trans  &trans
        &kp N0  &kp N4  &kp N5  &kp N6  &trans    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &kp N1  &kp N2  &kp N3  &trans    &trans  &trans  &trans  &trans  &trans  &trans
                        &to 0   &trans  &trans    &trans  &trans  &trans
            >;
        };

        mouse {
            bindings = <
        &trans  &trans  &trans  &trans  &trans    &trans     &trans          &trans          &trans        &trans
        &trans  &trans  &trans  &trans  &trans    &trans     &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT  &to 0
                        &to 0   &trans  &trans    &mkp RCLK  &mkp LCLK       &mkp MCLK
            >;
        };

        quick {
            bindings = <
        &kp CARET               &kp LG(LS(N2))          &kp LG(LS(N3))          &kp LG(LS(N4))          &kp LG(LS(N5))    &kp LG(LS(N5))  &kp LG(LS(N4))          &kp LG(LS(N3))          &kp LG(LS(N2))          &trans
        &kp LS(LA(LC(LG(N1))))  &kp LS(LA(LC(LG(N2))))  &kp LS(LA(LC(LG(N3))))  &kp LS(LA(LC(LG(N4))))  &kp C_MUTE        &kp C_MUTE      &kp LS(LA(LC(LG(N4))))  &kp LG(LS(LA(LC(N3))))  &kp LG(LA(LC(LS(N2))))  &kp LC(LS(LA(LG(N1))))
&trans  &kp LS(LA(LC(LG(M))))   &kp LS(LA(LC(LG(F))))   &kp LS(LA(LC(LG(G))))   &trans                  &trans            &trans          &trans                  &trans                  &trans                  &trans                  &trans
                                                        &trans                  &trans                  &trans            &trans          &trans                  &trans
            >;
        };

        macro {
            bindings = <
        &trans  &trans  &to 7   &trans  &trans    &trans  &trans  &trans  &trans  &trans
        &trans  &to 8   &trans  &trans  &trans    &trans  &trans  &trans  &to 7   &trans
&trans  &trans  &trans  &trans  &trans  &trans    &to 1   &trans  &trans  &trans  &trans  &trans
                        &trans  &mo 13  &trans    &trans  &trans  &trans
            >;
        };

        device {
            bindings = <
       &none  &none         &kp C_MUTE    &kp C_PLAY_PAUSE  &none    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
       &none  &kp C_BRI_UP  &kp C_VOL_UP  &kp C_NEXT        &none    &none         &none         &none         &none         &none
&none  &none  &kp C_BRI_DN  &kp C_VOL_DN  &kp C_PREV        &none    &none         &none         &none         &none         &none         &bt BT_CLR
                            &none         &none             &none    &none         &none         &none
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        device {
            if-layers = <1 12>;
            then-layer = <13>;
        };

        z_hyp_num {
            if-layers = <1 3>;
            then-layer = <4>;
        };

        l_num {
            if-layers = <1 8>;
            then-layer = <9>;
        };
    };
};
